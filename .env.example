# Copy to .env.local and restart `npm run dev` after changing.

# "1" = fake telemetry, three sample lakes and sample charts, for design review only.
# Leave unset (or 0) to see the real, honest empty states.
VITE_DEMO=1

# Base URL of the analytics backend (GET {base}/lakes/:lakeId/analytics). Optional.
# VITE_ANALYTICS_API_BASE=https://api.example.com

# Milliseconds without a telemetry packet before the robot shows as "Stale". Default 30000.
# VITE_TELEMETRY_STALE_AFTER_MS=30000

# Where the map opens when no lake is selected: "latitude,longitude" and zoom.
# Defaults to Bengaluru at zoom 12.
# VITE_MAP_CENTER=12.9716,77.5946
# VITE_MAP_ZOOM=12
