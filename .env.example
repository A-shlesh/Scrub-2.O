# Copy to .env.local and restart `npm run dev` after changing.

# "1" = fake telemetry, three sample lakes and sample charts, for design review only.
# Leave unset (or 0) to see the real, honest empty states.
VITE_DEMO=1

# Base URL of the analytics backend (GET {base}/lakes/:lakeId/analytics). Optional.
# VITE_ANALYTICS_API_BASE=https://api.example.com

# Milliseconds without a telemetry packet before the robot shows as "Stale". Default 30000.
# VITE_TELEMETRY_STALE_AFTER_MS=30000

# Where the map opens when no lake is selected: "latitude,longitude" and zoom.
# Defaults to Bengaluru at zoom 12.
# VITE_MAP_CENTER=12.9716,77.5946
# VITE_MAP_ZOOM=12

# Supabase: mission records, GCS, sensor history (and the command channel when no Pi URL is set).
# Never put the service_role key here: it belongs on the Raspberry Pi only.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Raspberry Pi backend. When set, the Mission page sends missions and commands to
# {VITE_API_BASE_URL}/api/... and live telemetry comes from {VITE_WS_BASE_URL}/ws/telemetry.
# Must be https:// / wss:// on Vercel. Leave unset to use Supabase for commands and telemetry.
# VITE_API_BASE_URL=https://scrub-pi.example.com
# VITE_WS_BASE_URL=wss://scrub-pi.example.com

# Robot id (default BOT001).
# VITE_ROBOT_ID=BOT001

# Robot figures for the route and the time / battery estimate (Mission page).
# Replace with measured values for your robot.
# VITE_ROBOT_SPEED_MPS=0.8
# VITE_BATTERY_MINUTES=120
# Default sweep spacing = effective cleaning width (can be changed per lake on the Mission page).
# VITE_SWEEP_SPACING_M=10
# Waypoint acceptance radius sent to the robot. Keep it below half the sweep spacing.
# VITE_ACCEPTANCE_RADIUS_M=3

# "1" = operators must sign in before using the dashboard (Supabase Auth).
# Only turn on after creating operator accounts and running supabase/optional/operator_security.sql.
# VITE_REQUIRE_LOGIN=1
